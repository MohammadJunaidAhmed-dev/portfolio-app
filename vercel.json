{
  "version": 2,
  "outputDirectory": "frontend/dist/portfolio-frontend/browser",
  "buildCommand": "cd frontend && npm install && npx ng build --configuration production",
  "routes": [
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|webp|json|pdf|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
